# Copy to deploy.env. Deploys to a host behind a TLS proxy.
DEMO_HOST=user@example.com
KEYCLOAK_PUBLIC_URL=https://keycloak.example.com
DEMO_ORIGIN=https://demo.example.com
WALLET_URL=https://wallet.example.com

# Optional. A checkout to build the image from, or an image the host can pull.
#KEYCLOAK_DIR=../../../keycloak
# The footer's name for a build. Defaults to the branch of KEYCLOAK_DIR, or the released version.
#KEYCLOAK_BUILD=my-branch
# Where the footer name links to, for example the build's pull request.
#KEYCLOAK_BUILD_URL=https://github.com/keycloak/keycloak/pull/1
# The headline of the start page, for example the pull request's title.
#KEYCLOAK_BUILD_TITLE=My feature
#KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
#KEYCLOAK_FEATURES=oid4vc-vci,oid4vc-vci-preauth-code

# Where Keycloak's wallet login link points. Keycloak after 26.8.1 also accepts a web address such
# as https://wallet.example.com/authorize, which opens a web wallet directly.
#WALLET_SCHEME=openid4vp://

# The wallet registration of this demo, see ../public-demo/relying-parties. Variants share it.
#RELYING_PARTY_ID=NLTEST.4B43444D4F
#RELYING_PARTY_SERVICE=keycloak-demo
# Where Keycloak and wallets fetch the issuer list. All variants share one.
#ISSUER_LIST_URL=https://keycloak.example.com/trust-lists/issuers.jwt

# VARIANT=my-branch ./deploy.sh all also reads deploy.env.my-branch, which overrides this file.
# A variant needs its own KEYCLOAK_PORT, and usually KEYCLOAK_DIR or KEYCLOAK_IMAGE.
#KEYCLOAK_PORT=18181
