# Copy to deploy.env. Deploys to a host behind a TLS proxy.
DEMO_HOST=user@example.com
KEYCLOAK_PUBLIC_URL=https://keycloak.example.com
DEMO_ORIGIN=https://demo.example.com
WALLET_URL=https://wallet.example.com

# Optional. A checkout to build the image from, or an image the host can pull.
#KEYCLOAK_DIR=../../../keycloak
# The footer's name for a build. Defaults to the branch of KEYCLOAK_DIR, or the released version.
#KEYCLOAK_BUILD=my-branch
#KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
#KEYCLOAK_FEATURES=oid4vc-vci,oid4vc-vci-preauth-code,oid4vc-vci-rest-credential-offer

# VARIANT=my-branch ./deploy.sh all also reads deploy.env.my-branch, which overrides this file.
# A variant needs its own KEYCLOAK_PORT, and usually KEYCLOAK_DIR or KEYCLOAK_IMAGE.
#KEYCLOAK_PORT=18181
