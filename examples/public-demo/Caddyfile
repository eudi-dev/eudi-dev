# Order the rate limiting plugin before authentication so it also limits password guesses.
{
	order rate_limit before basic_auth
}

# Wallets before 3.7.0 refuse cross-origin reads of these lists, so Caddy strips the Origin header.
# defer replaces the CORS header of newer wallets.
(trust_list_cors) {
	@trust_list_read {
		method GET HEAD
		path /api/trustlists/*
	}
	request_header @trust_list_read -Origin
	header @trust_list_read {
		defer
		Access-Control-Allow-Origin "*"
	}
}

# Over plain http, Caddy serves the CRLs and redirects everything else to
# https. ETSI EN 319 412-2 V2.5.1 GEN-4.3.11-4 requires an http CRL link. CRL
# clients such as Java's don't follow a redirect from http to https. An http
# site block turns off the automatic redirect for its host, so the snippet
# sends the redirect itself.
(http_site) {
	@crl {
		method GET HEAD
		path /api/crl /api/crl/*
	}
	handle @crl {
		reverse_proxy {args[0]}
	}
	handle {
		redir https://{host}{uri} 308
	}
	rate_limit {
		zone {args[1]} {
			key {remote_host}
			events 1200
			window 1m
		}
	}
}

http://eudi-test.dev {
	import http_site wallet:8085 http_demo_site
}

http://strict.eudi-test.dev {
	import http_site wallet-strict:8085 http_strict_site
}

http://preview.eudi-test.dev {
	import http_site wallet-preview:8085 http_preview_site
}

eudi-test.dev {
	import trust_list_cors
	# Serve the GoAccess report behind authentication configured in stats.env.
	handle_path /stats* {
		basic_auth {
			# Defaults to a hash of a random password nobody knows, so /stats
			# is locked until stats.env supplies real credentials.
			{$STATS_USER:admin} {$STATS_PASSWORD_HASH:$2a$14$V7D3pFZve2L.q3gUq4eClO5tFhhLhsqt/ArHoetKkFFshQT84QE5i}
		}
		root * /srv/stats
		file_server {
			index report.html
		}
	}

	handle {
		reverse_proxy wallet:8085
	}

	# Mask client addresses before writing the log. GoAccess uses the remaining network prefix to estimate visitors.
	log {
		# Keep the active log and up to three rotated files, about 40 MiB total. The report keeps its counts in its own database.
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}

	# Apply limits per client address. Every matching zone counts the request. Exceeding a limit returns 429 with Retry-After. The limits allow shared office addresses and ordinary test traffic.
	rate_limit {
		# These endpoints fetch external URLs or add wallet state. The minute limit permits short test bursts, while the hourly limit bounds sustained traffic.
		zone flows_burst {
			match {
				method POST
				path /api/presentations /api/dc-api /api/offers /api/issue /api/issuance /api/credentials /api/credentials/*/refresh /api/deferred/*/collect /issuer/api/offers /verifier/api/requests
			}
			key {remote_host}
			events 120
			window 1m
		}
		# A CRL check fetches external URLs, and a certificate list reads every credential.
		zone crl_checks {
			match {
				method GET HEAD
				path /api/credentials/*/certificate-status /api/credentials/*/certificates
			}
			key {remote_host}
			events 30
			window 1m
		}
		# Revocations change what every visitor sees.
		zone revocations {
			match {
				method POST DELETE
				path /api/certificates/revocations /api/certificates/revocations/*
			}
			key {remote_host}
			events 30
			window 1m
		}
		zone flows_hour {
			match {
				method POST
				path /api/presentations /api/dc-api /api/offers /api/issue /api/issuance /api/credentials /api/credentials/*/refresh /api/deferred/*/collect /issuer/api/offers /verifier/api/requests
			}
			key {remote_host}
			events 2000
			window 1h
		}
		# Registrar changes add relying parties and status list entries.
		zone registrar_burst {
			match {
				method POST PUT DELETE
				path /api/registrar/*
			}
			key {remote_host}
			events 60
			window 1m
		}
		zone registrar_hour {
			match {
				method POST PUT DELETE
				path /api/registrar/*
			}
			key {remote_host}
			events 600
			window 1h
		}
		# Everything else, including the UI and the stats report.
		zone site {
			key {remote_host}
			events 1200
			window 1m
		}
	}
}

# The conformance host accepts public GET and HEAD requests, including GET /authorize presentations. Other methods return 403. The harness uses an SSH tunnel for management access.
strict.eudi-test.dev {
	@write not method GET HEAD
	handle @write {
		respond 403
	}
	handle {
		reverse_proxy wallet-strict:8085
	}
	rate_limit {
		zone strict_site {
			key {remote_host}
			events 1200
			window 1m
		}
	}
}

# The preview host runs the newest release, betas included. Caddy provisions HTTPS automatically.
preview.eudi-test.dev {
	import trust_list_cors
	handle {
		reverse_proxy wallet-preview:8085
	}
	rate_limit {
		# A CRL check fetches external URLs, and a certificate list reads every credential.
		zone preview_crl_checks {
			match {
				method GET HEAD
				path /api/credentials/*/certificate-status /api/credentials/*/certificates
			}
			key {remote_host}
			events 30
			window 1m
		}
		# Revocations change what every visitor sees.
		zone preview_revocations {
			match {
				method POST DELETE
				path /api/certificates/revocations /api/certificates/revocations/*
			}
			key {remote_host}
			events 30
			window 1m
		}
		zone preview_site {
			key {remote_host}
			events 1200
			window 1m
		}
	}
}

# See examples/keycloak-public-demo. Keycloak's own first path segments go to the base deployment,
# and any other first segment to the variant of that name, so a new variant needs no change here.
keycloak.eudi-test.dev {
	log {
		output stdout
	}
	request_body {
		max_size 256KB
	}
	@internal path_regexp internal ^(/[a-z0-9-]+)?/(metrics|health(/.*)?|realms/[^/]+/(clients-registrations|account)(/.*)?)$
	@sensitive path_regexp sensitive ^(/[a-z0-9-]+)?/realms/[^/]+/(protocol/openid-connect/token|login-actions/.*)$
	rate_limit @sensitive {
		zone keycloak_demo_sensitive {
			key {remote_host}
			events 120
			window 1m
		}
	}
	rate_limit {
		zone keycloak_demo {
			key {remote_host}
			events 600
			window 1m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# OpenID4VCI puts well-known paths at the host root, before the issuer's path.
	@variant_metadata path_regexp metadata ^/[.]well-known/([^/]+)/([a-z0-9-]+)/realms/(.+)$
	@base path / /.well-known/* /realms/* /admin/* /resources/* /js/* /robots.txt
	@variant path_regexp variant ^/([a-z0-9-]+)(/|$)
	handle @internal {
		respond 404
	}
	handle /trust-lists/* {
		reverse_proxy demo-web:8080
	}
	handle @variant_metadata {
		rewrite /{re.metadata.2}/.well-known/{re.metadata.1}/realms/{re.metadata.3}
		reverse_proxy keycloak-{re.metadata.2}:8080
	}
	handle @base {
		reverse_proxy keycloak-base:8080
	}
	handle @variant {
		reverse_proxy keycloak-{re.variant.1}:8080
	}
	handle {
		respond 404
	}
	# The start page reads this response, and without the header browsers hide it as a network error.
	handle_errors 429 {
		header Access-Control-Allow-Origin https://demo.eudi-test.dev
		respond "Too many requests, try again in a minute." 429
	}
}

demo.eudi-test.dev {
	rate_limit {
		zone keycloak_demo_start_page {
			key {remote_host}
			events 300
			window 1m
		}
	}
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://keycloak.eudi-test.dev https://eudi-test.dev; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	@variant path_regexp ^/[a-z0-9-]+$
	redir @variant {path}/
	reverse_proxy demo-web:8080
}

# A static tracker of OpenID4VC work in Keycloak. Its files live in oid4vc-sig/ next to the compose file.
oid4vc-sig.eudi-test.dev {
	rate_limit {
		zone oid4vc_sig {
			key {remote_host}
			events 300
			window 1m
		}
	}
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# The files change in place on every data refresh.
		Cache-Control "no-cache"
		-Server
	}
	root * /srv/oid4vc-sig
	file_server
}
