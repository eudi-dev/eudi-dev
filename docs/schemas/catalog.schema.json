        "operator": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "schema": {
          "$ref": "#/$defs/registrar.AttestationSchema"
        },
        "template": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
