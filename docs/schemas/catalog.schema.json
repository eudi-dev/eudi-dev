        },
        "format": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "registrar.SchemaURI": {
      "additionalProperties": false,
      "properties": {
        "formatIdentifier": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "registrar.TrustAuthority": {
      "additionalProperties": false,
      "properties": {
        "frameworkType": {
          "type": "string"
        },
        "isLOTE": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "wallet.CatalogFileEntry": {
      "additionalProperties": false,
      "properties": {
