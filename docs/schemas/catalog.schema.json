  "$id": "https://raw.githubusercontent.com/eudi-dev/eudi-dev/main/docs/schemas/catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A document of a --catalog file: one attestation type or a list of them.",
  "oneOf": [
    {
      "$ref": "#/$defs/wallet.CatalogFileEntry"
    },
    {
      "items": {
        "$ref": "#/$defs/wallet.CatalogFileEntry"
      },
      "type": "array"
    }
  ],
  "title": "eudi-dev catalogue entries"
}
