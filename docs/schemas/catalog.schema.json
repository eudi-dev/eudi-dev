        "supportedFormats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trustedAuthorities": {
          "items": {
            "$ref": "#/$defs/registrar.TrustAuthority"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "registrar.CatalogCredential": {
      "additionalProperties": false,
